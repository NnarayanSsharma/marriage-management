# Copy to .env.local. Use isolated development services, never production data.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Integrations are not required to render the scaffold.
MONGODB_URI=
MONGODB_DB_NAME=marriage_management_dev
# Required to enable signup/reset. Confirm policy values before setting these.
# Proposed values: 15 characters, 7 days, 30 minutes, true (revoke sessions).
AUTH_PASSWORD_MIN_LENGTH=
AUTH_SESSION_DAYS=
AUTH_RESET_MINUTES=
AUTH_RESET_REVOKE_SESSIONS=
# TOKEN_HASH_SECRET: generate at least 32 random characters. Keep stable.
# SESSION_SECRET remains reserved; opaque sessions use TOKEN_HASH_SECRET.
SESSION_SECRET=
TOKEN_HASH_SECRET=
CRON_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_PLACES_API_KEY=
