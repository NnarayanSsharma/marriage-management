{
  "name": "marriage-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck",
    "db:auth-indexes": "node --conditions=react-server --import tsx scripts/auth-indexes.ts",
    "test": "node --conditions=react-server --import tsx --test tests/auth.integration.test.ts"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "mongoose": "^9.0.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
